<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Почему программисты необходимы общему делу</title>
    <style>
        :root {
            --bg-color: #060913;
            --nav-bg: rgba(6, 9, 19, 0.92);
            --card-bg: rgba(16, 26, 51, 0.65);
            --border-color: rgba(59, 130, 246, 0.25);
            --accent: #3b82f6;
            --accent-glow: rgba(59, 130, 246, 0.22);
            --quote-bg: rgba(59, 130, 246, 0.12);
            --text-main: #ffffff;      /* Чисто-белый основной цвет */
            --text-muted: #e2e8f0;     /* Светло-серебристый для описаний */
            --img-blend: lighten;
        }

        body.light-theme {
            --bg-color: #f8fafc;
            --nav-bg: rgba(255, 255, 255, 0.92);
            --card-bg: #ffffff;
            --border-color: rgba(37, 99, 235, 0.2);
            --accent: #2563eb;
            --accent-glow: rgba(37, 99, 235, 0.1);
            --quote-bg: rgba(37, 99, 235, 0.08);
            --text-main: #0f172a;
            --text-muted: #475569;
            --img-blend: normal;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.7;
            background-image: radial-gradient(circle at 50% 10%, var(--accent-glow), transparent 45%);
            min-height: 100vh;
            transition: background-color 0.3s, color 0.3s;
            overflow-x: clip;
        }

        /* Шапка со специализацией */
        .specialty-title {
            width: 100%;
            padding: 16px 15px;
            text-align: center;
            font-size: clamp(14px, 2.2vw, 20px);
            font-weight: 800;
            letter-spacing: 1.5px;
            color: var(--text-main);
            background: var(--bg-color);
            border-bottom: 1px solid var(--border-color);
            text-transform: uppercase;
        }

        /* Навигация с поддержкой мобильного меню */
        nav.site-nav {
            width: 100%;
            min-height: 68px;
            padding: 12px clamp(14px, 3vw, 32px);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            background: var(--nav-bg);
            border-bottom: 1px solid var(--border-color);
            box-shadow: 0 8px 28px rgba(0,0,0,.08);
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .site-nav .nav-links {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 8px;
            width: min(100%, 1240px);
        }

        .site-nav .nav-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 9px 14px;
            border-radius: 13px;
            font-size: .92rem;
            line-height: 1.3;
            text-align: center;
            color: var(--text-main);
            text-decoration: none;
            font-weight: 500;
            transition: 0.3s;
            border: 1px solid transparent;
        }

        .site-nav .nav-links a:hover { border-color: var(--accent); color: var(--accent); }
        .site-nav .nav-links a.active { background: var(--accent); color: #ffffff; box-shadow: 0 5px 16px var(--accent-glow); }

        .theme-btn {
            background: var(--card-bg); color: var(--text-main);
            border: 1px solid var(--border-color); padding: 9px 14px;
            border-radius: 13px; cursor: pointer; font-weight: 500;
            transition: 0.3s; margin-left: 4px; min-height: 42px; font-size: 0.9rem;
        }
        .theme-btn:hover { border-color: var(--accent); color: var(--accent); }

        /* Кнопка гамбургер для мобильных */
        .menu-toggle {
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 5px;
            width: 46px;
            height: 44px;
            padding: 10px;
            border: 1px solid var(--border-color);
            border-radius: 13px;
            background: var(--card-bg);
            color: var(--text-main);
            cursor: pointer;
        }
        .menu-toggle span {
            width: 20px;
            height: 2px;
            border-radius: 3px;
            background: currentColor;
            transition: transform .22s ease, opacity .18s ease;
        }
        .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(7px) rotate(45deg); }
        .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
        .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-7px) rotate(-45deg); }

        .container { max-width: 1160px; margin: 0 auto; padding: 45px 20px; width: min(100% - 40px, 1160px); }

        /* Верхний блок */
        .hero-society {
            display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: center;
            background: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 28px; padding: 45px; backdrop-filter: blur(16px);
            margin-bottom: 45px; box-shadow: 0 12px 35px rgba(0, 0, 0, 0.1);
        }
        .hero-society h1 { font-size: 2.6rem; margin-bottom: 16px; line-height: 1.2; letter-spacing: -0.5px; color: var(--text-main); }
        .hero-society h1 span { color: var(--accent); }
        .hero-society p { color: var(--text-muted); font-size: 1.12rem; }

        .hero-img-box {
            display: flex; justify-content: center; align-items: center;
        }
        .hero-img-box img {
            width: 100%; max-width: 540px;
            height: auto; max-height: 440px;
            object-fit: contain; display: block;
            border-radius: 20px;
            mix-blend-mode: var(--img-blend);
            transition: transform 0.4s ease;
        }
        .hero-img-box:hover img { transform: scale(1.05); }

        .section-heading {
            font-size: 1.85rem; margin-bottom: 24px;
            display: flex; align-items: center; gap: 12px;
            color: var(--text-main);
        }
        .section-heading::before {
            content: ""; display: inline-block; width: 6px; height: 28px;
            background: var(--accent); border-radius: 4px;
        }

        /* Список вклада в общество */
        .impact-list { display: flex; flex-direction: column; gap: 22px; margin-bottom: 55px; }
        .impact-item {
            display: flex; gap: 24px; align-items: flex-start;
            background: var(--card-bg); border: 1px solid var(--border-color);
            padding: 28px 32px; border-radius: 22px; backdrop-filter: blur(12px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
            transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
        }
        .impact-item:hover {
            transform: translateY(-4px);
            border-color: var(--accent);
            box-shadow: 0 12px 28px var(--accent-glow);
        }
        .number {
            background: var(--accent); color: #ffffff; font-weight: bold;
            font-size: 1.25rem; min-width: 50px; height: 50px;
            border-radius: 14px; display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .impact-item h3 { font-size: 1.32rem; margin-bottom: 8px; color: var(--text-main); }
        .impact-item p { color: var(--text-muted); font-size: 1rem; }

        /* Отдельный блок: Значимость для Татарстана и России */
        .geo-grid {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px;
            margin-bottom: 55px;
        }
        .geo-card {
            background: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 24px; padding: 34px 36px; backdrop-filter: blur(14px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
            display: flex; flex-direction: column; justify-content: space-between;
        }
        .geo-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent);
            box-shadow: 0 14px 32px var(--accent-glow);
        }
        .geo-badge {
            display: inline-block; align-self: flex-start;
            background: var(--quote-bg); color: var(--accent);
            border: 1px solid var(--border-color);
            padding: 5px 14px; border-radius: 12px;
            font-size: 0.85rem; font-weight: 700; letter-spacing: 0.5px;
            text-transform: uppercase; margin-bottom: 14px;
        }
        .geo-card h3 {
            font-size: 1.5rem; margin-bottom: 14px; color: var(--text-main); line-height: 1.3;
        }
        .geo-card p {
            color: var(--text-muted); font-size: 1.02rem; margin-bottom: 18px;
        }
        .geo-highlights {
            list-style: none; display: flex; flex-direction: column; gap: 10px;
            padding-top: 16px; border-top: 1px solid var(--border-color);
        }
        .geo-highlights li {
            color: var(--text-muted); font-size: 0.96rem;
            padding-left: 20px; position: relative;
        }
        .geo-highlights li strong { color: var(--text-main); }
        .geo-highlights li::before {
            content: "▸"; color: var(--accent); font-weight: bold;
            position: absolute; left: 0; top: 0;
        }

        /* Финальный блок */
        .conclusion-card {
            display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: center;
            background: var(--card-bg); border: 1px solid var(--border-color);
            border-radius: 28px; padding: 45px; backdrop-filter: blur(16px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.1);
        }
        .personal-img-box {
            display: flex; justify-content: center; align-items: center;
        }
        .personal-img-box img {
            width: 100%; max-width: 480px;
            height: auto; max-height: 420px;
            object-fit: contain; display: block;
            border-radius: 20px;
            mix-blend-mode: var(--img-blend);
            transition: transform 0.4s ease;
        }
        .personal-img-box:hover img { transform: scale(1.05); }

        .conclusion-text h2 { font-size: 1.9rem; margin-bottom: 14px; color: var(--accent); }
        .conclusion-text p { color: var(--text-muted); font-size: 1.08rem; margin-bottom: 22px; }

        .quote-box {
            padding: 22px 26px; border-left: 4px solid var(--accent);
            background: var(--quote-bg); border-radius: 0 16px 16px 0;
            font-style: italic; font-size: 1.05rem; text-align: left;
            color: var(--text-main);
        }

        footer { text-align: center; padding: 35px; color: var(--text-muted); font-size: 0.95rem; }

        /* Адаптивность для телефонов и планшетов */
        @media (max-width: 900px) {
            .container { width: min(100% - 32px, 760px); padding: 34px 0; }
            .hero-society, .conclusion-card { grid-template-columns: 1fr; text-align: center; padding: 30px 20px; }
            .geo-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 700px) {
            nav.site-nav { min-height: 62px; justify-content: flex-end; padding: 9px 16px; }
            .menu-toggle { display: flex; }
            .site-nav .nav-links {
                display: none;
                position: absolute;
                top: calc(100% + 1px);
                left: 0;
                right: 0;
                width: 100%;
                max-height: calc(100dvh - 70px);
                overflow-y: auto;
                flex-direction: column;
                align-items: stretch;
                justify-content: flex-start;
                gap: 7px;
                padding: 13px 16px 18px;
                background: var(--nav-bg);
                border-bottom: 1px solid var(--border-color);
                box-shadow: 0 16px 30px rgba(0,0,0,.2);
                backdrop-filter: blur(18px);
                -webkit-backdrop-filter: blur(18px);
            }
            .site-nav .nav-links.is-open { display: flex; }
            .site-nav .nav-links a, .site-nav .nav-links .theme-btn {
                display: flex;
                width: 100%;
                min-height: 48px;
                justify-content: flex-start;
                margin: 0;
                padding: 12px 15px;
                border-radius: 12px;
                font-size: .96rem;
                text-align: left;
            }
            .site-nav .nav-links .theme-btn { justify-content: center; margin-top: 4px; }
            body.menu-open { overflow: hidden; }

            .container { width: min(100% - 24px, 100%); padding: 25px 12px; }
            h1 { font-size: 1.75rem !important; }
            .section-heading { font-size: 1.45rem !important; }
            .impact-item { flex-direction: column; gap: 14px; padding: 20px 16px; }
        }
    </style>    
</head>
<body>
    <div class="specialty-title">
        09.02.07 Информационные системы и программирование
    </div>

   

    <div class="container">
        <!-- Главный блок -->
        <section class="hero-society">
